guage": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#1A237E",\n    "secondary": "#e3e3e3",\n    "accent": "#FF6F00"\n  },\n  "theme": "light",\n  "layoutDescription": "The UI features a dashboard with real-time attendee count and flow graphs. Admins access participant management, analytics, and configuration panels. Gate staff use a streamlined scan interface showing IN/OUT confirmation, alerts, and optional user photo. Reports and logs are accessible via dedicated tabs."\n}'}",
